{
    "name": "sgrigorjev/confluence-api-doc",
    "description": "A tool for converting OpenAPI documents into natively formatted Confluence pages and automatically publishing them via the Confluence API",
    "type": "project",
    "authors": [
        {
            "name": "Sergey Grigorjev",
            "email": "sergey.grigoriev.web@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "ConfluenceApiDoc\\": "src/"
        }
    },
    "bin": [
        "bin/confluence-api-doc"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "psr/log": "^1.1",
        "damienharper/adf-tools": "^1.2",
        "symfony/console": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^7.3"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
